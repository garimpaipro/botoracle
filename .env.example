# ==========================================
# Configurações de Autenticação Oracle Cloud (OCI)
# ==========================================
OCI_USER_OCID=ocid1.user.oc1..aaaaaaaaxxxxxxx
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaaxxxxxxx
OCI_COMPARTMENT_OCID=ocid1.tenancy.oc1..aaaaaaaaxxxxxxx
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:11:22:33:44:55:66:77:88:99:00
OCI_REGION=sa-saopaulo-1

# Você pode fornecer a chave privada apontando para o arquivo OU colocando o conteúdo direto:
OCI_KEY_FILE=~/.oci/oci_api_key.pem
# OCI_KEY_CONTENT="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ==========================================
# Configurações da Instância
# ==========================================
OCI_INSTANCE_NAME=Oracle-Free-ARM
OCI_AVAILABILITY_DOMAIN=XXXX:SA-SAOPAULO-1-AD-1
OCI_SUBNET_OCID=ocid1.subnet.oc1.sa-saopaulo-1.aaaaaaaaxxxxxxx
OCI_IMAGE_OCID=ocid1.image.oc1.sa-saopaulo-1.aaaaaaaaxxxxxxx

# Configuração de Recursos (Default: VM.Standard.A1.Flex com 4 OCPUs e 24GB RAM - Limite Always Free)
OCI_SHAPE=VM.Standard.A1.Flex
OCI_OCPUS=4
OCI_MEMORY_IN_GBS=24
OCI_BOOT_VOLUME_SIZE_IN_GBS=50

# Chave SSH Pública (Exemplo: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA..." ou o conteúdo completo da sua chave id_rsa.pub)
OCI_SSH_PUBLIC_KEY="ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ..."

# ==========================================
# Configurações do Bot & Notificações
# ==========================================
# Intervalo de tentativas em segundos (Recomendado: 60)
RETRY_INTERVAL=60

# Notificações via Telegram (Opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notificações via Discord Webhook (Opcional)
DISCORD_WEBHOOK_URL=
